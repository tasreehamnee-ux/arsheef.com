# قاعدة البيانات
MONGODB_URI=mongodb://localhost:27017/arsheef
# أو
# MYSQL_HOST=localhost
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=arsheef

# الخادم
PORT=3000
NODE_ENV=development

# Fabres Integration
FABRES_ENABLED=true
